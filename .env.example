# Copy to .env and adjust. All amounts are in millimes (1 TND = 1000 millimes).
NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=claimflow
DB_PASSWORD=claimflow
DB_NAME=claimflow

# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600
BCRYPT_ROUNDS=10

# Claim documents are stored here (PDF, PNG, JPEG, max 5 MB each)
UPLOAD_DIR=uploads
THROTTLE_LIMIT=100
# true only behind a reverse proxy such as Nginx
TRUST_PROXY=false
